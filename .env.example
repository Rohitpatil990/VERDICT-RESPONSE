# VERDICT Multi-Region Docker Environment Configuration

# Regional Node Ports
MUMBAI_PORT=4001
DELHI_PORT=4002
BENGALURU_PORT=4003

# Web Dashboard Port
WEB_PORT=3000

# Container Hostnames (Docker Bridge Network)
PEER_HOST_MUMBAI=verdict-mumbai
PEER_HOST_DELHI=verdict-delhi
PEER_HOST_BENGALURU=verdict-bengaluru

# Data Directory (Inside Container)
DATA_DIR=/app/data
