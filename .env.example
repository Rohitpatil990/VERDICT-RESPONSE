# VERDICT Response Environment Configuration Example

# Regional Server Ports
MUMBAI_PORT=4001
DELHI_PORT=4002
BENGALURU_PORT=4003

# Dashboard Dev Port
DASHBOARD_PORT=3000

# Persistence Adapter (default: sqlite using Node 24 native DatabaseSync)
STORE_ADAPTER=sqlite

# Optional Remote Translation Provider (disabled by default for offline privacy)
# TRANSLATE_PROVIDER=google_cloud
# TRANSLATE_API_KEY=your_api_key_here
